      "id": "photocraft",
      "name": "PhotoCraft",
      "purpose": "Raster images, layers, masks and PSD",
      "executable": "photocraft-cli",
      "confinement": "read_write",
      "args": [
        "mcp",
        "--automation-read-root",
        "{work}",
        "--automation-write-root",
        "{outputs}"
