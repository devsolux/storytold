# Example for POSIX shells. This file is documentation, never auto-sourced.
# Supply absolute, non-symlink paths. Native executables are not bundled.
# On Windows use PowerShell $env:... and pinned *-cli.exe binaries.
export CRAFT_BIN_DIR=/absolute/trusted/craft/bin
export CRAFT_WORK_ROOT=/absolute/private/craft-work
export CRAFT_OUTPUT_ROOT=/absolute/private/craft-work/outputs
# Create the workspace with: python3 storytold.py workspace-init --root "$CRAFT_WORK_ROOT"
# CRAFT_OUTPUT_ROOT must be exactly the real workspace's outputs directory.
